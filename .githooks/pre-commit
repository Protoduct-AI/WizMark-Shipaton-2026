#!/usr/bin/env bash
# Fast checks only — this runs on every commit, so it stays under a second.
# Anything needing a build belongs in pre-push.
#
# Skip with: SKIP_HOOKS=1 git commit ...
[[ "${SKIP_HOOKS:-0}" == "1" ]] && exit 0

repo="$(git rev-parse --show-toplevel)"
exec "$repo/scripts/check.sh"
